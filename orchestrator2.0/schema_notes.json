    "信息系统": {
      "propagate": [
        {
          "rel": "承载于",
          "depth": 1,
          "role": "承载的业务"
        }
      ]
    },
    "事项主管部门": {
      "propagate": [
        {
          "rel": "主管事项",
          "depth": 1,
          "role": "主管的业务"
        },
        {
          "rel": "主管部门",
          "depth": 1,
          "role": "主管的子项"
        }
      ]
    },
    "协同业务": {
      "propagate": [
        {
          "rel": "协同参与",
          "depth": 1,
          "role": "参与的业务"
        }
      ]
    },
    "业务表": {
      "propagate": [
        {
          "rel": "形成业务表",
          "depth": 1,
          "role": "来源子项"
        },
        {
          "rel": "对象对应表",
          "depth": 1,
          "role": "对应对象"
        }
      ]
    },
    "源数据实体": {
      "propagate": [
        {
          "rel": "引用源实体",
          "depth": 1,
          "role": "引用的底账"
        }
      ]
    }
  },
  "query_examples": [
    "MATCH (n:`业务事项`) WHERE n.`名称` CONTAINS $keyword RETURN n.`事项ID` AS id, n.`名称` AS name ORDER BY n.`事项ID` LIMIT 100",
    "MATCH (n:`业务事项`) WHERE n.`事项ID` = $id RETURN n LIMIT 1",
    "MATCH (a:`业务事项`)-[:`业务依赖`*1..6]->(root:`业务事项`) WHERE root.`事项ID` = $id AND a.`事项ID` <> $id RETURN DISTINCT a.`事项ID` AS id, a.`名称` AS name LIMIT 100",
    "MATCH (s:`业务事项` {事项ID: $id})-[:包含子项]->(x:`业务子项`) RETURN x.`名称`, x.`办理状态`, x.`业务描述` LIMIT 100",
    "MATCH (s:`业务事项`)-[:主管事项]->(d:`事项主管部门`) WHERE s.`名称` CONTAINS $kw RETURN s.`名称`, d.`名称` LIMIT 100"
  ],
