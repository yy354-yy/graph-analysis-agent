  "relationship_meanings": {
    "包含子项": {
      "含义": "结构归属，不等于跨业务影响",
      "方向": "业务事项 -> 业务子项"
    },
    "主管部门": {
      "含义": "子项的主管部门；共同主管不证明业务依赖",
      "方向": "业务子项 -> 事项主管部门"
    },
    "归口司局": {
      "含义": "组织归口关系",
      "方向": "事项主管部门 -> 司局"
    },
    "承载于": {
      "含义": "事项由该系统承载；相关系统需确认，不自动判为系统故障",
      "方向": "业务事项 -> 信息系统"
    },
    "服务于": {
      "含义": "业务面向的服务对象类别",
      "方向": "业务事项 -> 服务对象"
    },
    "处理对象": {
      "含义": "业务处理的对象",
      "方向": "业务事项 -> 业务对象"
    },
    "包含子对象": {
      "含义": "业务对象的组成部分",
      "方向": "业务对象 -> 子对象"
    },
    "形成业务表": {
      "含义": "子项形成的业务底账，不包含技术字段级映射",
      "方向": "业务子项 -> 业务表"
    },
    "对象对应表": {
      "含义": "对象登记在业务底账中的关联",
      "方向": "业务对象 -> 业务表"
    },
    "引用源实体": {
      "含义": "底账引用来源实体的登记关系",
      "方向": "业务表 -> 源数据实体"
    },
    "来源于": {
      "含义": "实体来源登记，不自动等同业务影响传播",
      "方向": "源数据实体 -> 源系统"
    },
    "系统对接": {
      "含义": "系统之间的数据对接登记",
      "方向": "信息系统 -> 源系统"
    },
    "协同发起": {
      "含义": "事项发起协同场景",
      "方向": "业务事项 -> 协同业务"
    },
    "协同参与": {
      "含义": "参与协同不等同于业务依赖",
      "方向": "协同业务 -> 业务事项"
    },
    "协同事项": {
      "含义": "事项之间存在协同，仅作为关联证据",
      "方向": "业务事项 -> 业务事项"
    },
    "业务依赖": {
      "含义": "起点依赖终点；终点变化时，沿入边寻找可能受影响的起点",
      "方向": "业务事项 -> 业务事项"
    },
    "子项依赖": {
      "含义": "后序子项依赖前序子项的办理结果",
      "方向": "业务子项 -> 业务子项"
    },
    "引用对象": {
      "含义": "子项引用业务对象",
      "方向": "业务子项 -> 业务对象"
    },
    "实体映射": {
      "含义": "实体级整理映射登记；不是字段级血缘",
      "方向": "源数据实体 -> 源数据实体"
    },
    "使用系统": {
      "含义": "子项使用的办理系统",
      "方向": "业务子项 -> 信息系统"
    },
    "主管事项": {
      "含义": "事项的主管部门；不能按同部门自动传播业务影响",
      "方向": "业务事项 -> 事项主管部门"
    }
  },
  "influence_rules": {
    "业务依赖": "A-[业务依赖]->B 表示 A 依赖 B。分析 B 变更时沿入边反向扩展，最多 6 跳，去重并排除 B 自身。",
    "子项依赖": "A-[子项依赖]->B 表示 A 依赖 B；用于子项层模拟影响，不自动扩展成其他业务的确定影响。",
    "其他关系": "主管、归口、承载、协同和来源关系提供关联证据，不能单独当成业务影响传播依据。",
    "关联系统": "先依据业务依赖得到候选业务，再列它们的承载系统作为需要检查的系统，不能断言系统故障。"
  },
  "display_notes": "业务名称统一取「名称」属性；展示业务时附事项ID/子项ID以便用户确认。多候选场景展示顺序必须与 state.candidates 数组顺序一致。",
  "entity_roles": {
    "业务事项": {
      "propagate": [
        {
          "rel": "业务依赖",
          "depth": 6,
          "role": "受影响候选"
        }
      ],
      "compose": {
        "rel": "包含子项",
        "child": "业务子项"
      }
    },
    "业务子项": {
      "propagate": [
        {
          "rel": "子项依赖",
          "depth": 1,
          "role": "关联子项"
        }
      ],
      "compose": null
